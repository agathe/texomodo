# ---------------------------------------------------------------------------
# TexoModo (Review Mode) configuration for one website project
# Copy to .env in the project for local development. On Netlify, set these in
# Site configuration -> Environment variables. Never commit .env.
# ---------------------------------------------------------------------------

# --- Public values (safe to ship to the browser; written to review/config.json)
# Supabase project URL and the *publishable* key (Project Settings -> API Keys;
# called "anon" on the Legacy tab). Safe for the browser: RLS protects the data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Which website this is inside the Supabase project. (Prefixed because Netlify
# reserves SITE_ID and SITE_NAME for its own read-only values.) One project (and one
# Google OAuth client) can serve several sites, each with its own reviewer
# list. Lowercase slug, must exist in the `sites` table (`npm run allowlist`
# creates it). Required when SUPABASE_URL is set.
TEXOMODO_SITE_ID=allsaints
TEXOMODO_SITE_NAME=All Saints Catholic Church

# Shown as a hint on the sign-in dialog ("Sign in with your @domain account").
# Enforcement happens in the database (review_access table), not here.
ALLOWED_GOOGLE_DOMAIN=

# --- Allowlist (used only by `npm run allowlist`, which needs the service role key)
# Comma-separated list of individual reviewer emails (e.g. personal Gmail accounts).
ALLOWED_EMAILS=
# Maintainers: may verify, resolve and edit anyone's comments. Comma-separated emails.
ALLOWED_MAINTAINERS=
# Optional. Maintainers on EVERY site in this Supabase project (site = NULL rows),
# for whoever runs the platform. Leave empty to leave existing platform rows alone.
PLATFORM_ADMINS=

# --- Secret: local machine only. Never set this on Netlify, never ship to browser.
# The *secret* key (sb_secret_...; "service_role" on the Legacy tab).
# Used by texomodo allowlist to write the review_access table.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional
# "true" shows the "Ask AI to change this" button on comments. Leave unset until
# the Phase 2 change-request pipeline exists (docs/ai-change-requests.md).
REVIEW_AI_CHANGES=
# "true" lets Review Mode run with browser-local storage and no backend
# (for UI development). Ignored when SUPABASE_URL is set.
REVIEW_LOCAL_MODE=
